#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 The Relevo authors
# relevo — run Claude Code as one of several accounts (work, personal, client orgs) and move a
# conversation from one account to another, the way Claude Code's docs describe multiple
# accounts: one CLAUDE_CONFIG_DIR per account.
#
# Each profile lives in ~/.claude-profiles/<folder> with its own login. Everything else links
# back to ~/.claude, so settings, plugins, skills, agents, commands, hooks, memory and session
# history are shared, which is why a conversation can continue on another account.
# Profiles are called by the part of the account's email before the @ (relevo names).
#
#   relevo add <email> [--sso] [--name <name>]
#                                add an account: new profile, then Claude Code's own sign-in page
#   relevo list [--cached]       every account: name, login expiry, and its 5-hour / weekly usage
#                                (live from Claude Code's /usage; --cached: last seen only)
#   relevo account               the same, marking the account this session runs on (/account)
#   relevo statusline            status-line segment: put "relevo statusline" in settings.json
#   relevo <name> [claude args]  run claude as that account, e.g. relevo jane.doe --resume <id>
#   relevo run <name> [args]     the same, for a name that matches one of these commands
#   relevo rename <name> <new>   give an account another name
#   relevo names                 (re)name every profile from its account email (replaces renames)
#   relevo new <folder>          add an empty profile without signing in
#   relevo fix <name>            re-create shared links (if a settings save replaced one)
#   relevo install               put relevo on your PATH (~/.local/bin/relevo)
#
# Inside a session started with relevo, type  /switch <name> : this session closes and the
# same conversation reopens on that account, in the same terminal.
#
# Never reads or prints credentials. Never touches the default profile's login. A profile's
# folder is never renamed: Claude Code ties the login to the folder's path.
set -u

PROG=relevo
BASE="${RELEVO_HOME:-$HOME/.claude-profiles}"
MAIN="$HOME/.claude"
NAMES="$BASE/.names"            # lines: "<name> <target>", target = main or a folder in BASE
SWITCH_DIR="$BASE/.switch"
BIN_COPY="$BASE/.bin/$PROG"     # stable copy that ~/.local/bin/relevo points to
UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
NAME_RE='^[a-z0-9][a-z0-9._-]{0,63}$'
USAGE_DIR="$BASE/.usage"        # <t>.json last-seen status-line usage, <t>.live /usage lines,
                                # <t>.login login-expiry cache, <t>.limited last rate-limit stop
PREFS="$BASE/.prefs"            # warn_days=N, written from the plugin's settings at session start
RESERVED=" main add list account statusline names new fix run rename install help "
NOTES=""                        # warnings collected while checking usage
LIVE_TTL=60                     # seconds a live /usage result is reused
USAGE_TIMEOUT="${RELEVO_USAGE_TIMEOUT:-20}"; [[ "$USAGE_TIMEOUT" =~ ^[0-9]{1,3}$ ]] || USAGE_TIMEOUT=20
WARN_DAYS="${RELEVO_WARN_DAYS:-}"
[ -z "$WARN_DAYS" ] && [ -f "$PREFS" ] && WARN_DAYS="$(sed -n 's/^warn_days=\([0-9]*\)$/\1/p' "$PREFS" | head -1)"
[[ "$WARN_DAYS" =~ ^[0-9]{1,3}$ ]] || WARN_DAYS=5
SHARED=(settings.json CLAUDE.md agents commands hooks output-styles plugins skills projects
        file-history plans dev-mods history.jsonl)

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
valid() { [[ "$1" =~ $NAME_RE ]] || die "names use a-z, 0-9, '.', '-' and '_' (got '$1')"; }

# name or folder -> target ("main" or a folder name in BASE); empty if unknown
resolve() {
  local n="$1" t
  [ "$n" = main ] && { echo main; return; }
  if [ -f "$NAMES" ]; then
    t="$(awk -v n="$n" '$1 == n { print $2; exit }' "$NAMES")"
    [ -n "$t" ] && { echo "$t"; return; }
  fi
  [ -d "$BASE/$n" ] && [ ! -L "$BASE/$n" ] && echo "$n"
}

# target -> display name (first name mapped to it, else the target itself)
name_of() {
  local t="$1" n=""
  [ -f "$NAMES" ] && n="$(awk -v t="$t" '$2 == t { print $1; exit }' "$NAMES")"
  echo "${n:-$t}"
}

# Run a command with the right config for a target. The default profile runs with
# CLAUDE_CONFIG_DIR unset: setting it to ~/.claude would make Claude Code look for another login.
env_cmd() {  # target -> ENVCMD, the env prefix that selects its config
  if [ "$1" = main ]; then ENVCMD=(env -u CLAUDE_CONFIG_DIR); else ENVCMD=(env "CLAUDE_CONFIG_DIR=$BASE/$1"); fi
}
cfg_env() { local t="$1"; shift; env_cmd "$t"; "${ENVCMD[@]}" "$@"; }

# The account a running session belongs to: RELEVO_PROFILE (set by the wrapper), else
# CLAUDE_CONFIG_DIR, else a path under it such as the session's transcript_path (for when
# CLAUDE_CODE_SUBPROCESS_ENV_SCRUB removed CLAUDE_CONFIG_DIR). Unset config means main;
# a config folder outside the profiles folder prints nothing.
current_target() {
  local p="${RELEVO_PROFILE:-}" c="${CLAUDE_CONFIG_DIR:-${1:-}}" rest
  if [ -n "$p" ] && [[ "$p" =~ $NAME_RE ]] && { [ "$p" = main ] || [ -d "$BASE/$p" ]; }; then echo "$p"; return; fi
  case "$c" in
    "$BASE"/*) rest="${c#"$BASE"/}"; rest="${rest%%/*}"
               [[ "$rest" =~ $NAME_RE ]] && [ -d "$BASE/$rest" ] && { echo "$rest"; return; } ;;
  esac
  [ -z "${CLAUDE_CONFIG_DIR:-}" ] && echo main
  return 0
}

targets() { echo main; [ -d "$BASE" ] && for d in "$BASE"/*/; do [ -d "$d" ] && [ ! -L "${d%/}" ] && basename "$d"; done; }

# --- login status, from `claude auth status --json` (no secrets in it; nothing else is read) ---
# Sets LOGIN (in|out|unknown), EXP_DATE (YYYY-MM-DD or empty), EXP_LEFT (seconds or empty), EMAIL.
json_str() { printf '%s' "$2" | LC_ALL=C sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p"; }
iso_epoch() {  # 2026-12-16T05:00:00.000Z -> epoch seconds (BSD and GNU date)
  local s="${1%%.*}"; s="${s%Z}"; s="${s%+00:00}"
  date -u -j -f '%Y-%m-%dT%H:%M:%S' "$s" +%s 2>/dev/null || date -u -d "${s}Z" +%s 2>/dev/null
}
login_state() {
  read_login "$1"
  # remember it for the status line, which must not start claude on every refresh
  mkdir -p "$USAGE_DIR" 2>/dev/null && chmod 700 "$USAGE_DIR" 2>/dev/null &&
    put_file "$USAGE_DIR/$1.login" "$(date +%s) ${EXP_EPOCH:--} $LOGIN"
  return 0
}
read_login() {
  local j exp
  LOGIN=unknown EXP_DATE="" EXP_LEFT="" EXP_EPOCH="" EMAIL=""
  j="$(cfg_env "$1" claude auth status --json 2>/dev/null | one_line)"
  [ -n "$j" ] || return 0
  if printf '%s' "$j" | grep -q '"loggedIn"[[:space:]]*:[[:space:]]*true'; then LOGIN=in
  elif printf '%s' "$j" | grep -q '"loggedIn"[[:space:]]*:[[:space:]]*false'; then LOGIN=out; return 0
  else return 0; fi
  EMAIL="$(json_str email "$j")"
  exp="$(json_str loginExpiresAt "$j")"
  [ -n "$exp" ] || return 0
  EXP_DATE="${exp:0:10}"
  EXP_EPOCH="$(iso_epoch "$exp")" && [ -n "$EXP_EPOCH" ] && EXP_LEFT=$(( EXP_EPOCH - $(date +%s) ))
  return 0
}
usable() { [ "$LOGIN" = in ] && { [ -z "$EXP_LEFT" ] || [ "$EXP_LEFT" -gt 0 ]; }; }   # after login_state
put_file() {  # path text: atomic write, owner-only
  local tmp
  tmp="$(mktemp "$(dirname "$1")/.tmp.XXXXXX")" && printf '%s\n' "$2" > "$tmp" && chmod 600 "$tmp" && mv "$tmp" "$1"
}
login_line() {  # target -> one line for `relevo list`
  local days
  login_state "$1"
  case "$LOGIN" in
    out) echo "NOT signed in"; return ;;
    unknown) echo "status unknown"; return ;;
  esac
  if [ -z "$EXP_LEFT" ]; then echo "signed in"; return; fi
  if [ "$EXP_LEFT" -le 0 ]; then
    echo "login expired $EXP_DATE  ← sign in again: $PROG $(name_of "$1"), then /login"; return
  fi
  days=$(( EXP_LEFT / 86400 ))
  local when="in $days days"; [ "$days" -eq 1 ] && when="in 1 day"; [ "$days" -eq 0 ] && when="in under a day"
  local warn=""; [ "$days" -lt "$WARN_DAYS" ] && warn="  ← sign in again soon"
  echo "signed in · login expires $when ($EXP_DATE)$warn"
}
local_name() {  # email -> its local part, lower-cased and made into a valid name (may be empty)
  printf '%s' "${1%%@*}" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9._-]/-/g; s/^[^a-z0-9]*//' | cut -c1-64
}
email_local() {  # target -> name from its signed-in email, or empty
  login_state "$1"
  [ "$LOGIN" = in ] && [[ "$EMAIL" == *@* ]] || return 0
  local_name "$EMAIL"
}

# " a b c ": every word a new name must not be (commands, names in use, folder names)
taken_words() {
  local w="$RESERVED" t
  [ -f "$NAMES" ] && w="$w$(awk '{ printf "%s ", $1 }' "$NAMES")"
  while read -r t; do w="$w$t "; done < <(targets)
  echo "$w"
}
dedupe() {  # name, taken words -> name, or name-2, name-3 … if taken
  local n="$1" base="$1" i=2
  while [[ "$2" == *" $n "* ]]; do n="$base-$i"; i=$((i+1)); done
  echo "$n"
}
set_name() {  # name target: map name to target, dropping that target's and that name's old lines
  local tmp
  mkdir -p "$BASE" && chmod 700 "$BASE" || die "could not create $BASE"
  tmp="$(mktemp "$BASE/.names.XXXXXX")" || die "could not write in $BASE"
  [ -f "$NAMES" ] && awk -v n="$1" -v t="$2" '$1 != n && $2 != t' "$NAMES" > "$tmp"
  printf '%s %s\n' "$1" "$2" >> "$tmp"
  chmod 600 "$tmp" && mv "$tmp" "$NAMES" || die "could not save names"
}
make_profile() {  # folder: create it with the shared links
  local dir="$BASE/$1"
  { [ -e "$dir" ] || [ -L "$dir" ]; } && die "$dir already exists"
  mkdir -p "$BASE" && chmod 700 "$BASE" || die "could not create $BASE"
  mkdir -m 700 "$dir" || die "could not create $dir"
  link_shared "$dir"
}

# --- usage: 5-hour / weekly limits, only ever as Claude Code itself reports them ---------------
# Live: Claude Code's own /usage command, headless (no model call). Run from an empty temp folder
# with only project settings, so the shared ~/.claude settings' hooks, plugins and MCP servers
# do not start for it. Fallback: what the status line last saw (relevo statusline).
one_line() {  # stdin -> one line without terminal escapes or control characters, even raw
  LC_ALL=C sed "s/$(printf '\033')\[[0-9;?]*[A-Za-z]//g" | LC_ALL=C tr -d '\000-\010\013-\037' | tr -d '\n'
}
json_obj() {  # key json -> inner text of "key": { … } (flat objects only)
  printf '%s' "$2" | LC_ALL=C sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*{\([^{}]*\)}.*/\1/p" | head -1
}
json_num() { printf '%s' "$2" | LC_ALL=C sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\(-\{0,1\}[0-9][0-9.eE+-]*\).*/\1/p" | head -1; }
json_result() {  # the "result" string of a claude -p JSON answer, unescaped
  local raw
  raw="$(printf '%s' "$1" | LC_ALL=C sed -nE 's/.*"result"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)".*/\1/p' | head -1)"
  printf '%b' "$(printf '%s' "$raw" | sed 's/\\"/"/g')"
}
window() {  # inner text of a rate_limits window -> W_PCT (whole %) and W_RESET (epoch), or empty
  local p r
  W_PCT="" W_RESET=""
  p="$(json_num used_percentage "$1")"
  [ -n "$p" ] && W_PCT="$(awk -v x="$p" 'BEGIN { printf "%d", x + 0.5 }')"
  r="$(json_num resets_at "$1")"
  if [ -z "$r" ]; then r="$(json_str resets_at "$1")"; [ -n "$r" ] && r="$(iso_epoch "$r")"; fi
  r="${r%%.*}"
  if [[ "$r" =~ ^[0-9]+$ ]]; then [ "$r" -gt 100000000000 ] && r=$(( r / 1000 )); W_RESET="$r"; fi
}
dur() { if [ "$1" -ge 86400 ]; then printf '%dd%dh' $(( $1 / 86400 )) $(( $1 % 86400 / 3600 ))
        else printf '%dh%02dm' $(( $1 / 3600 )) $(( $1 % 3600 / 60 )); fi; }

live_fresh() {  # target: a /usage result younger than LIVE_TTL exists
  local f="$USAGE_DIR/$1.live" t
  [ -f "$f" ] || return 1
  t="$(head -1 "$f")"
  [[ "$t" =~ ^[0-9]+$ ]] && [ $(( $(date +%s) - t )) -lt "$LIVE_TTL" ]
}
store_live() {  # target, claude -p output file
  local j turns lines
  j="$(one_line < "$2")"   # stdout only: fetch_live never mixes stderr into it
  printf '%s' "$j" | grep -q '"subtype"[[:space:]]*:[[:space:]]*"success"' || return 0
  turns="$(json_num num_turns "$j")"
  if [ -n "$turns" ] && [ "$turns" != 0 ]; then
    NOTES="${NOTES}note: the usage check for $(name_of "$1") ran a model turn, which it never should; its result is not used.
"
    return 0
  fi
  lines="$(json_result "$j" | sed 's/^[[:space:]]*//' | grep -F '% used' | grep -vE '^(Last|Top) ')"
  [ -n "$lines" ] && put_file "$USAGE_DIR/$1.live" "$(date +%s)
$lines"
}
watchdog() {  # pid seconds: stop pid after that long, unless this watchdog is stopped first
  local s
  trap 'kill "$s" 2> /dev/null; exit 0' TERM
  sleep "$2" & s=$!
  wait "$s" && kill -TERM "$1" 2> /dev/null
}
# Live /usage for each target, all at once, each stopped after USAGE_TIMEOUT seconds.
fetch_live() {
  local tmpd t pid jobs="" j
  [ $# -gt 0 ] || return 0
  mkdir -p "$USAGE_DIR" && chmod 700 "$USAGE_DIR" || return 0
  tmpd="$(mktemp -d "${TMPDIR:-/tmp}/relevo-usage.XXXXXX")" || return 0
  {  # stderr off here: bash reports every stopped job ("Terminated") when it reaps it
    for t in "$@"; do
      live_fresh "$t" && continue
      env_cmd "$t"
      ( cd "$tmpd" && exec "${ENVCMD[@]}" claude -p "/usage" --output-format json --no-session-persistence \
          --setting-sources project --strict-mcp-config < /dev/null > "$tmpd/$t.out" ) &
      pid=$!
      ( watchdog "$pid" "$USAGE_TIMEOUT" ) > /dev/null &
      jobs="$jobs $pid:$!"
    done
    for j in $jobs; do wait "${j%%:*}"; kill -TERM "${j#*:}"; wait "${j#*:}"; done
  } 2> /dev/null
  for t in "$@"; do [ -s "$tmpd/$t.out" ] && store_live "$t" "$tmpd/$t.out"; done
  rm -rf "$tmpd"
}
cache_line() {  # target -> "usage: 5h N% used, resets in … · 7d …   (seen N min ago)"
  local f="$USAGE_DIR/$1.json" j now seen w part parts="" ago
  [ -f "$f" ] || { echo "usage: not seen yet (shows after this account's next reply)"; return; }
  j="$(tr -d '\n' < "$f")"; now=$(date +%s)
  for w in five_hour:5h seven_day:7d; do
    window "$(json_obj "${w%%:*}" "$j")"
    [ -n "$W_PCT" ] || continue
    if [ -n "$W_RESET" ] && [ "$W_RESET" -le "$now" ]; then part="${w#*:} reset since"
    elif [ -n "$W_RESET" ]; then part="${w#*:} $W_PCT% used, resets in $(dur $(( W_RESET - now )))"
    else part="${w#*:} $W_PCT% used"; fi
    parts="${parts:+$parts · }$part"
  done
  seen="$(json_num seen "$j")"; seen="${seen%%.*}"; ago=""
  if [[ "$seen" =~ ^[0-9]+$ ]]; then
    ago=$(( (now - seen) / 60 ))
    if [ "$ago" -lt 120 ]; then ago="   (seen $ago min ago)"; else ago="   (seen $(( ago / 60 )) h ago)"; fi
  fi
  echo "usage: ${parts:-no data}$ago"
}
usage_lines() {  # target -> the lines to show under it: live if fresh, else last seen
  if live_fresh "$1"; then tail -n +2 "$USAGE_DIR/$1.live"; else cache_line "$1"; fi
}
# target -> 0 when a window is at 100% (LIMIT_TEXT says which, and when it resets)
at_limit() {
  local j now w
  LIMIT_TEXT=""
  if live_fresh "$1"; then
    LIMIT_TEXT="$(tail -n +2 "$USAGE_DIR/$1.live" | grep -E '(^|[^0-9])100% used' | head -2 | paste -sd ';' - | sed 's/;/; /g')"
    [ -n "$LIMIT_TEXT" ]; return
  fi
  [ -f "$USAGE_DIR/$1.json" ] || return 1
  j="$(tr -d '\n' < "$USAGE_DIR/$1.json")"; now=$(date +%s)
  for w in five_hour:5h seven_day:7d; do
    window "$(json_obj "${w%%:*}" "$j")"
    [ -n "$W_PCT" ] && [ "$W_PCT" -ge 100 ] || continue
    [ -n "$W_RESET" ] && [ "$W_RESET" -le "$now" ] && continue
    LIMIT_TEXT="${w#*:} 100% used${W_RESET:+, resets in $(dur $(( W_RESET - now )))} (last seen)"
    return 0
  done
  return 1
}
fullness() {  # target -> highest % it shows (999 when unknown), for picking where to continue
  local m
  if live_fresh "$1"; then
    m="$(tail -n +2 "$USAGE_DIR/$1.live" | grep -oE '[0-9]+% used' | tr -dc '0-9\n' | sort -n | tail -1)"
  else
    m="$(cache_line "$1" | grep -oE '[0-9]+% used' | tr -dc '0-9\n' | sort -n | tail -1)"
  fi
  echo "${m:-999}"
}

link_shared() {
  local dir="$1" item
  for item in "${SHARED[@]}"; do
    [ -e "$MAIN/$item" ] || continue
    [ -L "$dir/$item" ] && continue
    if [ -e "$dir/$item" ]; then
      printf '  kept %s (a real file is there; remove it and run "%s fix" to share it again)\n' "$item" "$PROG"
      continue
    fi
    ln -s "$MAIN/$item" "$dir/$item"
  done
}

# Run claude for a target and stay around: if the session asked to switch (via /switch), reopen
# the same conversation on the requested target. Otherwise exit with claude's exit code.
# The session always closes before it reopens, so it is never open in two profiles at once.
run_loop() {
  local target="$1"; shift
  local req="$SWITCH_DIR/$$" code to sid dir
  mkdir -p "$SWITCH_DIR" && chmod 700 "$BASE" "$SWITCH_DIR" || die "could not create $SWITCH_DIR"
  [ -n "${CLAUDE_CODE_CHILD_SESSION:-}" ] && \
    printf '%s: note: started from inside a Claude Code session; Claude Code leaves nested sessions out of --resume.\n' "$PROG" >&2
  while :; do
    rm -f "$req"
    cfg_env "$target" RELEVO_WRAPPER=$$ RELEVO_PROFILE="$target" claude "$@"
    code=$?
    [ -f "$req" ] || exit "$code"
    to="$(sed -n 1p "$req")"; sid="$(sed -n 2p "$req")"; dir="$(sed -n 3p "$req")"; rm -f "$req"
    [[ "$to" =~ $NAME_RE ]] && { [ "$to" = main ] || { [ -d "$BASE/$to" ] && [ ! -L "$BASE/$to" ]; }; } \
      || die "no profile '$to' in switch request"
    [[ "$sid" =~ $UUID_RE ]] || die "bad session id in switch request"
    if [ -n "$dir" ] && [ -d "$dir" ]; then cd "$dir" || die "could not enter $dir"; fi
    printf '\n↪ continuing this conversation as %s …\n\n' "$(name_of "$to")"
    target="$to"
    set -- --resume "$sid"
  done
}

# Called by /switch from inside a running session (the plugin passes the session's environment).
# Exit 0: a switch was requested and the caller should close the session now.
# Exit 3: nothing to do; the printed line says why. Exit 1: an error.
# Exit 4: that account is at a usage limit; nothing done. The caller may ask the person and
#         call again with --anyway.
cmd_switch() {
  local want="" anyway="" to sid dir tmp
  while [ $# -gt 0 ]; do
    case "$1" in --anyway) anyway=1 ;; *) [ -z "$want" ] && want="$1" ;; esac; shift
  done
  [ -n "$want" ] || { echo "usage: /switch <name>   ($PROG list shows the names)"; exit 3; }
  [[ "$want" =~ $NAME_RE ]] || { echo "No account named '$want' ($PROG list shows them)."; exit 3; }
  to="$(resolve "$want")"
  [ -n "$to" ] || { echo "No account named '$want' ($PROG list shows them)."; exit 3; }
  sid="${CLAUDE_CODE_SESSION_ID:-}"
  [[ "$sid" =~ $UUID_RE ]] || die "this doesn't look like a Claude Code session"
  if [ "${RELEVO_PROFILE:-}" = "$to" ]; then echo "Already on $want."; exit 3; fi
  login_state "$to"
  if [ "$LOGIN" = out ] || { [ -n "$EXP_LEFT" ] && [ "$EXP_LEFT" -le 0 ]; }; then
    printf '%s is not signed in%s. Sign in again: %s %s, then /login\n' "$want" \
      "${EXP_DATE:+ (login expired $EXP_DATE)}" "$PROG" "$want"
    exit 3
  fi
  if [ -z "$anyway" ]; then
    fetch_live "$to"
    if at_limit "$to"; then printf '%s is at a usage limit: %s\n' "$want" "$LIMIT_TEXT"; exit 4; fi
  fi
  dir="${CLAUDE_PROJECT_DIR:-$PWD}"
  if [ -z "${RELEVO_WRAPPER:-}" ] || ! [[ "$RELEVO_WRAPPER" =~ ^[0-9]+$ ]] || ! kill -0 "$RELEVO_WRAPPER" 2>/dev/null; then
    printf 'This session was not started with %s, so it cannot reopen itself.\nExit, then run:  cd %q && %s %s --resume %s\n' \
      "$PROG" "$dir" "$PROG" "$want" "$sid"
    exit 3
  fi
  mkdir -p "$SWITCH_DIR" && chmod 700 "$SWITCH_DIR" || die "could not create $SWITCH_DIR"
  tmp="$(mktemp "$SWITCH_DIR/.req.XXXXXX")" && printf '%s\n%s\n%s\n' "$to" "$sid" "$dir" > "$tmp" \
    && mv "$tmp" "$SWITCH_DIR/$RELEVO_WRAPPER" || die "could not write the switch request"
  echo "Switching to $want: this session closes and reopens as $want with the same conversation."
}

cmd_names() {
  local tmp used t n base i
  mkdir -p "$BASE" && chmod 700 "$BASE" || die "could not create $BASE"
  tmp="$(mktemp "$BASE/.names.XXXXXX")" || die "could not write in $BASE"
  used="$RESERVED"   # plain string, not an associative array: macOS ships bash 3.2
  while read -r t; do
    n="$(email_local "$t")"
    if [ -z "$n" ]; then printf '  %-8s not signed in, left unnamed\n' "$t"; continue; fi
    base="$n"; i=2; while [[ "$used" == *" $n "* ]]; do n="$base-$i"; i=$((i+1)); done
    used="$used$n "; printf '%s %s\n' "$n" "$t" >> "$tmp"
    printf '  %-8s → %s\n' "$t" "$n"
  done < <(targets)
  chmod 600 "$tmp" && mv "$tmp" "$NAMES" || die "could not save names"
  echo "Names saved. Use them with $PROG <name> and /switch <name>."
}

cmd_new() {
  local folder="${1:-}"
  [ -n "$folder" ] || die "usage: $PROG new <folder>"
  valid "$folder"
  [[ "$RESERVED" == *" $folder "* ]] && die "'$folder' is a $PROG command or the default profile"
  [ -n "$(resolve "$folder")" ] && die "'$folder' is already taken"
  make_profile "$folder"
  printf 'Created profile %s.\nSign in once:  %s %s   then type /login, exit, and run:  %s names\n' \
    "$folder" "$PROG" "$folder" "$PROG"
}

# Guided sign-in: a new profile, then Claude Code's own browser sign-in for it. Relevo never sees
# a password or token; it checks the result with `claude auth status` afterwards.
cmd_add() {
  local email="" sso="" name="" given="" folder i code want got taken
  while [ $# -gt 0 ]; do
    case "$1" in
      --sso) sso=--sso ;;
      --name) shift; name="${1:-}"; given=1 ;;
      --name=*) name="${1#--name=}"; given=1 ;;
      -*) die "unknown option $1 (usage: $PROG add <email> [--sso] [--name <name>])" ;;
      *) [ -z "$email" ] || die "usage: $PROG add <email> [--sso] [--name <name>]"; email="$1" ;;
    esac
    shift
  done
  [[ "$email" =~ ^[^@[:space:]]+@[^@[:space:]]+$ ]] || die "usage: $PROG add <email> [--sso] [--name <name>]"
  taken="$(taken_words)"
  if [ -n "$given" ]; then
    valid "$name"
    [[ "$taken" == *" $name "* ]] && die "'$name' is already taken (or is a $PROG command)"
  else
    name="$(local_name "$email")"; [ -n "$name" ] || die "cannot make a name from '$email'; pass --name"
    name="$(dedupe "$name" "$taken")"
  fi
  i=2; while [ -e "$BASE/acc$i" ] || [ -L "$BASE/acc$i" ] || [[ "$taken" == *" acc$i "* ]]; do i=$((i+1)); done
  folder="acc$i"
  make_profile "$folder"
  set_name "$name" "$folder"
  printf 'Created profile %s (%s). Opening Claude Code'"'"'s sign-in page for %s …\n' "$name" "$folder" "$email"
  if [ -n "$sso" ]; then cfg_env "$folder" claude auth login --claudeai --email "$email" --sso
  else cfg_env "$folder" claude auth login --claudeai --email "$email"; fi
  code=$?
  login_state "$folder"
  if [ "$LOGIN" != in ]; then
    printf 'Not signed in yet (sign-in exit code %s). The profile is kept; finish later with:  %s %s   then /login\n' \
      "$code" "$PROG" "$name"
    exit 1
  fi
  want="$(printf '%s' "$email" | tr 'A-Z' 'a-z')"; got="$(printf '%s' "$EMAIL" | tr 'A-Z' 'a-z')"
  if [ -n "$got" ] && [ "$got" != "$want" ]; then
    if [ -n "$given" ]; then
      printf 'Notice: this profile signed in as %s, not %s. It keeps the name %s.\n' "$EMAIL" "$email" "$name"
    else
      local new; new="$(local_name "$EMAIL")"
      [ -n "$new" ] && [ "$new" != "$name" ] && new="$(dedupe "$new" "$(taken_words)")" && set_name "$new" "$folder"
      printf 'Notice: this profile signed in as %s, not %s, so it is named %s.\n' "$EMAIL" "$email" "${new:-$name}"
      name="${new:-$name}"
    fi
  fi
  printf 'Signed in. Start it with:  %s %s\n' "$PROG" "$name"
}

cmd_rename() {
  local old="${1:-}" new="${2:-}" t
  [ -n "$old" ] && [ -n "$new" ] || die "usage: $PROG rename <name> <new name>"
  valid "$old"; valid "$new"
  t="$(resolve "$old")"; [ -n "$t" ] || die "no account named '$old'"
  [ "$(resolve "$new")" = "$t" ] && { echo "$old is already called $new."; return; }
  [[ "$(taken_words)" == *" $new "* ]] && die "'$new' is already taken (or is a $PROG command)"
  set_name "$new" "$t"
  echo "Renamed $old to $new."
}

cmd_fix() {
  local want="${1:-}" t
  [ -n "$want" ] || die "usage: $PROG fix <name>"
  valid "$want"; t="$(resolve "$want")"
  [ -n "$t" ] && [ "$t" != main ] || die "no profile '$want'"
  link_shared "$BASE/$t"; echo "Links checked for $want."
}

# Every account with its login, then (unless --cached) a live usage check of the usable ones
# in parallel. MARK, when set, is the target to mark as "this session".
cmd_list() {
  local cached="" tmpd t l mark ok=() all=()
  [ "${1:-}" = --cached ] && cached=1
  tmpd="$(mktemp -d "${TMPDIR:-/tmp}/relevo-list.XXXXXX")" || die "no temp folder"
  while read -r t; do
    all+=("$t")
    login_line "$t" > "$tmpd/$t"
    usable && ok+=("$t") && : > "$tmpd/$t.ok"
  done < <(targets)
  [ -z "$cached" ] && [ ${#ok[@]} -gt 0 ] && fetch_live "${ok[@]}"
  for t in "${all[@]}"; do
    mark=""; if [ -n "${MARK:-}" ]; then mark="  "; [ "$MARK" = "$t" ] && mark="▶ "; fi
    printf '%s%-24s %-8s %s\n' "$mark" "$(name_of "$t")" "($t)" "$(cat "$tmpd/$t")"
    [ -f "$tmpd/$t.ok" ] && usage_lines "$t" | sed 's/^/                                   /'
  done
  rm -rf "$tmpd"
  [ -n "${NOTES:-}" ] && printf '%s' "$NOTES"
  return 0
}

# /account: the list, this session's account marked, and where to continue if it is at a limit.
cmd_account() {
  local cur best
  cur="$(current_target)"
  echo "Accounts (▶ this session):"
  MARK="$cur" cmd_list "$@"
  [ -n "$cur" ] || return 0
  printf '\nThis session runs on %s.' "$(name_of "$cur")"
  if at_limit "$cur"; then
    best="$(best_other "$cur")"
    if [ -n "$best" ]; then printf ' It is at a usage limit; to continue this conversation on %s:  /switch %s\n' "$best" "$best"
    else printf ' It is at a usage limit, and no other signed-in account has room right now.\n'; fi
  else printf '\n'; fi
}

best_other() {  # current target -> name of the usable account with the most room (uses caches)
  local t f best="" bestf=1000
  while read -r t; do
    [ "$t" = "$1" ] && continue
    [ -f "$USAGE_DIR/$t.login" ] || continue
    login_ok_cached "$t" || continue
    at_limit "$t" && continue
    f="$(fullness "$t")"
    [ "$f" -lt "$bestf" ] && { bestf="$f"; best="$(name_of "$t")"; }
  done < <(targets)
  echo "$best"
}
login_ok_cached() {  # target: its cached login state is signed in and not expired
  local c e
  c="$(cat "$USAGE_DIR/$1.login" 2>/dev/null)"
  [ "${c##* }" = in ] || return 1
  e="$(echo "$c" | awk '{ print $2 }')"
  [ "$e" = - ] || [ "$e" -gt "$(date +%s)" ]
}

# Called by the plugin when a turn stopped on a rate limit: record it and say where the
# conversation could continue. Never switches by itself.
cmd_limited() {
  local cur t others=() best line sid="${CLAUDE_CODE_SESSION_ID:-}" dir="${CLAUDE_PROJECT_DIR:-$PWD}"
  cur="$(current_target)"; [ -n "$cur" ] || exit 0
  mkdir -p "$USAGE_DIR" && chmod 700 "$USAGE_DIR" && put_file "$USAGE_DIR/$cur.limited" "$(date +%s)"
  while read -r t; do
    [ "$t" = "$cur" ] && continue
    login_state "$t"; usable && others+=("$t")
  done < <(targets)
  [ ${#others[@]} -gt 0 ] && fetch_live "${others[@]}"
  best="$(best_other "$cur")"
  if [ -z "$best" ]; then
    echo "Usage limit reached on $(name_of "$cur"). No other signed-in account has room right now ($PROG list shows them)."
    exit 0
  fi
  line="$(usage_lines "$(resolve "$best")" | head -1)"
  if [ -n "${RELEVO_WRAPPER:-}" ] && [[ "$RELEVO_WRAPPER" =~ ^[0-9]+$ ]] && kill -0 "$RELEVO_WRAPPER" 2>/dev/null; then
    echo "Usage limit reached on $(name_of "$cur"). To continue this conversation on $best:  /switch $best   ($line)"
  else
    printf 'Usage limit reached on %s. To continue this conversation on %s, exit, then run:  cd %q && %s %s --resume %s   (%s)\n' \
      "$(name_of "$cur")" "$best" "$dir" "$PROG" "$best" "$sid" "$line"
  fi
}

# Status-line segment: "name · 5h N% · 7d N% · model", and a login warning under WARN_DAYS.
# Reads only the JSON Claude Code passes on stdin; remembers the usage for relevo list.
cmd_statusline() {
  local in t name five seven model out now c e days
  in="$(one_line)"; now=$(date +%s)
  t="$(current_target "$(json_str transcript_path "$in")")"
  if [ -n "$t" ]; then name="$(name_of "$t")"; else name="$(basename "${CLAUDE_CONFIG_DIR:-claude}")"; fi
  five="$(json_obj five_hour "$in")"; seven="$(json_obj seven_day "$in")"
  if [ -n "$t" ] && { [ -n "$five" ] || [ -n "$seven" ]; } && mkdir -p "$USAGE_DIR" 2>/dev/null; then
    chmod 700 "$USAGE_DIR" 2>/dev/null
    put_file "$USAGE_DIR/$t.json" "{\"seen\":$now,\"five_hour\":{$five},\"seven_day\":{$seven}}" 2>/dev/null
  fi
  out="$name"
  window "$five";  [ -n "$W_PCT" ] && out="$out · 5h $W_PCT%"
  window "$seven"; [ -n "$W_PCT" ] && out="$out · 7d $W_PCT%"
  model="$(json_str display_name "$(json_obj model "$in")")"; [ -n "$model" ] && out="$out · $model"
  if [ -n "$t" ]; then
    c="$(cat "$USAGE_DIR/$t.login" 2>/dev/null)"; e="${c%% *}"; [[ "$e" =~ ^[0-9]+$ ]] || e=0
    # refresh the login cache in the background when it is missing or older than 6 hours
    if [ $(( now - e )) -gt 21600 ]; then
      ( "$BASH" "$0" _login_cache "$t" > /dev/null 2>&1 & ) 2> /dev/null
    fi
    e="$(echo "$c" | awk '{ print $2 }')"
    if [[ "$e" =~ ^[0-9]+$ ]]; then
      if [ "$e" -le "$now" ]; then out="$out · login expired"
      else days=$(( (e - now) / 86400 )); [ "$days" -lt "$WARN_DAYS" ] && out="$out · login expires in ${days}d"; fi
    fi
  fi
  printf '%s\n' "$out"
}

self_path() { local d; d="$(cd -P "$(dirname "$0")" && pwd -P)" && echo "$d/$(basename "$0")"; }

# Copy this script to a stable place and link ~/.local/bin/relevo to it. The plugin refreshes
# the copy at session start (_sync), so plugin updates reach the command on your PATH.
cmd_install() {
  local self link="$HOME/.local/bin/$PROG"
  self="$(self_path)" || die "cannot find myself"
  if [ -e "$link" ] || [ -L "$link" ]; then
    [ -L "$link" ] && [ "$(readlink "$link")" = "$BIN_COPY" ] || die "$link already exists and is not $PROG's link; remove it first"
  fi
  mkdir -p "$BASE/.bin" "$HOME/.local/bin" && chmod 700 "$BASE" || die "could not create folders"
  copy_self "$self" || die "could not copy to $BIN_COPY"
  [ -L "$link" ] || ln -s "$BIN_COPY" "$link" || die "could not create $link"
  echo "Installed: $link → $BIN_COPY"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) echo "Run $PROG list in a terminal to check it." ;;
    *) echo "~/.local/bin is not on your PATH yet; add it in your shell profile, then run $PROG list." ;;
  esac
}
copy_self() {  # atomic replace, so a running copy is never half-written
  local tmp
  tmp="$(mktemp "$BASE/.bin/.$PROG.XXXXXX")" && cp "$1" "$tmp" && chmod 755 "$tmp" && mv "$tmp" "$BIN_COPY"
}
cmd_sync() {  # at session start: save the plugin's settings; refresh the installed copy if it differs
  local self
  if [ -d "$BASE" ] && [ -n "${RELEVO_WARN_DAYS:-}" ] && [[ "$RELEVO_WARN_DAYS" =~ ^[0-9]{1,3}$ ]] \
     && [ "$(cat "$PREFS" 2>/dev/null)" != "warn_days=$RELEVO_WARN_DAYS" ]; then
    put_file "$PREFS" "warn_days=$RELEVO_WARN_DAYS"
  fi
  [ -f "$BIN_COPY" ] || exit 0
  self="$(self_path)" || exit 0
  [ "$self" = "$BIN_COPY" ] && exit 0
  cmp -s "$self" "$BIN_COPY" || copy_self "$self" || exit 1
}

cmd="${1:-}"
case "$cmd" in
  ""|-h|--help|help) awk 'NR > 1 && /^#/ { if (/SPDX-License|^# Copyright/) next; sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" ;;
  _switch) shift; cmd_switch "$@" ;;
  _sync)   cmd_sync ;;
  _limited) cmd_limited ;;
  _login_cache) [[ "${2:-}" =~ $NAME_RE ]] && { [ "$2" = main ] || [ -d "$BASE/$2" ]; } && login_state "$2" ;;
  statusline) cmd_statusline ;;
  account) shift; cmd_account "$@" ;;
  add)     shift; cmd_add "$@" ;;
  rename)  shift; cmd_rename "$@" ;;
  names)   cmd_names ;;
  new)     shift; cmd_new "$@" ;;
  fix)     shift; cmd_fix "$@" ;;
  list)    shift; cmd_list "$@" ;;
  install) cmd_install ;;
  run|*)
    [ "$cmd" = run ] && { shift; cmd="${1:-}"; [ -n "$cmd" ] || die "usage: $PROG run <name> [claude args]"; }
    valid "$cmd"; t="$(resolve "$cmd")"
    [ -n "$t" ] || die "no account named '$cmd' ($PROG list shows them; $PROG new adds one)"
    shift; run_loop "$t" "$@"
    ;;
esac
